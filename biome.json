{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/shared/libs/*/**", "!@/shared/libs/*/index"],
                "message": "Import only from the libs topic root (@/shared/libs/X) — that's the public barrel. Internal files of the topic (provider, hooks, constants) must not be imported directly from outside the topic, regardless of depth. If the export you need isn't in index.ts, add it there."
              },
              {
                "group": ["@/shared/ui/*/**", "!@/shared/ui/*/index"],
                "message": "Import only from the ui component root (@/shared/ui/X) — that's the public barrel. Internal component files (.test, .stories, .types) must not be imported directly from outside, regardless of depth."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/app/**",
              "@/shared/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
